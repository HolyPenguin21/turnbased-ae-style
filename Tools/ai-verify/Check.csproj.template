<Project Sdk="Microsoft.NET.Sdk">
  <!-- Compile check of Assets/ outside Unity. Generated into the work dir by compile_check.sh.
       UnityData / UnityLibrary empty: stub mode; set (common.sh, AI_VERIFY_UNITY): real assemblies. -->
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <Nullable>disable</Nullable>
    <DefineConstants>UNITY_INCLUDE_TESTS;UNITY_EDITOR;UNITY_2021_3_OR_NEWER;UNITY_6000_0_OR_NEWER</DefineConstants>
    <NoWarn>$(NoWarn);CS0618;CS0414;CS0169;CS0649;CS0219;CS0162;CS0168;CS8632</NoWarn>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <AssemblyName>Assembly-CSharp</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="$(SrcAssets)/**/*.cs" />
  </ItemGroup>
  <ItemGroup Condition="'$(UnityData)' == ''">
    <PackageReference Include="NUnit" Version="3.14.0" />
    <Compile Include="EngineStubs.cs" />
    <PackageReference Include="UnityEngine.Modules" Version="2021.3.33" />
    <PackageReference Include="Unity3D.UnityEngine.UI" Version="2020.3.21" />
  </ItemGroup>
  <ItemGroup Condition="'$(UnityData)' != ''">
    <Reference Include="$(UnityData)/Managed/UnityEngine/UnityEngine*.dll" />
    <Reference Include="$(UnityData)/Managed/UnityEngine/UnityEditor*.dll" />
    <Reference Include="$(UnityData)/Managed/UnityEngine/Unity.*.dll" />
    <Reference Include="$(UnityLibrary)/Unity.TextMeshPro.dll" />
    <Reference Include="$(UnityLibrary)/Unity.InputSystem.dll" />
    <Reference Include="$(UnityLibrary)/UnityEngine.UI.dll" />
    <Reference Include="$(UnityLibrary)/UnityEditor.UI.dll" />
    <!-- LogAssert (UnityEngine.TestTools); its calls only run inside Unity. -->
    <Reference Include="$(UnityLibrary)/UnityEngine.TestRunner.dll" />
    <!-- The NUnit the editor compiles the tests against (com.unity.ext.nunit): its API is older
         than NuGet NUnit 3.14, e.g. Does.Not.Contain takes only a string. -->
    <Reference Include="$(UnityNUnit)" />
  </ItemGroup>
</Project>
