<Project Sdk="Microsoft.NET.Sdk">

  <!-- Acceptance harness for the Recon ownership / accounting invariants exposed by the
       AiDebug(20260902-082556) live-log review: one durable Recon role per physical scout
       (§1/§10), event/battle interruptions are not structural failures (§2), the ReconOnly
       scope isolates missions not hand management (§5/§13), and the §4 local-vs-distant
       Explore BaseValue ordering. Scenarios that need a live HexMap / VisionSystem / aviation
       stack (impossible-Refresh assignment contention E, live step planner F, AirRecon sortie
       H, long-run I) are exercised in-editor, matching the rest of the Tools/ suite. -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AssemblyName>recon-ownership-sim</AssemblyName>
    <RootNamespace>ReconOwnershipSim</RootNamespace>
    <EnableDefaultCompileItems>true</EnableDefaultCompileItems>
    <UnityManaged>D:\Unity\Editor\6000.5.4f1\Editor\Data\Managed\UnityEngine</UnityManaged>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Assembly-CSharp.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="UnityEngine">
      <HintPath>$(UnityManaged)\UnityEngine.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(UnityManaged)\UnityEngine.CoreModule.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>

</Project>
