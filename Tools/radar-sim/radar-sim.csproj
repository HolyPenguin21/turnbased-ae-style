<Project Sdk="Microsoft.NET.Sdk">

  <!-- Standalone verification harness for the Strategy V2 desire evaluators (build-order step 3).
       Hand-builds WorldSnapshot POCOs for curated positions and asserts the normalised Radar
       tilts the right way + the DesireBreakdown sub-terms behave. Exercises the real evaluator
       code (StrategyLayer / CombatOpportunityAnalyzer / AiPower / WorthIt) via a ProjectReference
       to the Unity-generated Assembly-CSharp.csproj, same pattern as Tools/stealth-sim. Pure
       model layer only — no MonoBehaviour / scene / coroutine code is touched. -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AssemblyName>radar-sim</AssemblyName>
    <RootNamespace>RadarSim</RootNamespace>
    <EnableDefaultCompileItems>true</EnableDefaultCompileItems>
    <UnityManaged>D:\Unity\Editor\6000.5.4f1\Editor\Data\Managed\UnityEngine</UnityManaged>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Assembly-CSharp.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="UnityEngine">
      <HintPath>$(UnityManaged)\UnityEngine.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(UnityManaged)\UnityEngine.CoreModule.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>

</Project>
