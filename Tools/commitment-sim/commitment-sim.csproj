<Project Sdk="Microsoft.NET.Sdk">

  <!-- Standalone acceptance harness for Strategy V2 build-order step 7 — Mission Continuity
       (Assets/Scripts/Ai/V2/MissionIntent.cs + ScoutObjectiveEvaluator.cs, plus the step-7 hooks
       in ReconMissionPlanner / ResourceAllocator). Drives the durable-intent state machine across
       scripted turns and asserts a multi-turn recon chain survives Radar noise without re-planning
       from scratch. Same pattern as Tools/radar-sim / Tools/stealth-sim: a console Exe that
       ProjectReferences the Unity-generated Assembly-CSharp.csproj, so it always runs the current
       game code. Pure model layer only — no MonoBehaviour / scene / coroutine. The V2 stage
       classes are `internal`; V2InternalsVisibleTo.cs names this assembly. -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AssemblyName>commitment-sim</AssemblyName>
    <RootNamespace>CommitmentSim</RootNamespace>
    <EnableDefaultCompileItems>true</EnableDefaultCompileItems>
    <UnityManaged>D:\Unity\Editor\6000.5.4f1\Editor\Data\Managed\UnityEngine</UnityManaged>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Assembly-CSharp.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="UnityEngine">
      <HintPath>$(UnityManaged)\UnityEngine.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(UnityManaged)\UnityEngine.CoreModule.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>

</Project>
