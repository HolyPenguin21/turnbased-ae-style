<Project Sdk="Microsoft.NET.Sdk">

  <!-- Standalone acceptance harness for the Strategy V2 "Capability Quality, Contextual Scout
       Decisions & Terminal AP" task (Assets/Scripts/Ai/V2/ScoutCapabilityQuality.cs +
       CapabilityQualityEvaluator.cs + ScoutCapabilityContext.cs + ScoutOptionalStealthPolicy.cs,
       plus the Phase-B terminal-draw config in AiConfigV2 / StrategicManager). Drives the PURE
       evaluators / policy methods directly and asserts BEHAVIOUR, not magnitudes: marginal
       mobility / vision / spot value, contextual stealth, hero opportunity cost, the optional
       stealth Enter/Skip decision and its AP opportunity cost, and the retirement of the old
       speculative Phase-B reserves. Same pattern as Tools/mission-selection-sim: a console Exe
       that ProjectReferences the Unity-generated Assembly-CSharp.csproj so it always runs the
       current game code. Pure model layer only — no MonoBehaviour / scene / coroutine. The V2
       quality evaluator is `internal`; V2InternalsVisibleTo.cs names this assembly. -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AssemblyName>capability-quality-sim</AssemblyName>
    <RootNamespace>CapabilityQualitySim</RootNamespace>
    <EnableDefaultCompileItems>true</EnableDefaultCompileItems>
    <UnityManaged>D:\Unity\Editor\6000.5.4f1\Editor\Data\Managed\UnityEngine</UnityManaged>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Assembly-CSharp.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="UnityEngine">
      <HintPath>$(UnityManaged)\UnityEngine.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(UnityManaged)\UnityEngine.CoreModule.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>

</Project>
