    guardArmyName: 
    rewards:
    - type: 0
      resources:
        human: 0
        energy: 0
        materials: 0
        tech: 2
      cardKey: 
  - name: Abandoned warehouse
    image: {fileID: 21300000, guid: a220bd1f5f6eb7a4fbd3c515e0e6df1a, type: 3}
    description: 'An abandoned warehouse has been discovered: a decaying structure
      with a rusted sign and a heavy iron door sealed by a massive padlock. The air
      inside smells of dampness, machine oil, and centuries-old dust. Looks like
      someone is inside: 2 targets.'
    guardArmyName: Inhabitants
    rewards:
    - type: 0
      resources:
        human: 0
        energy: 1
        materials: 1
        tech: 0
      cardKey: 
    - type: 1
      resources:
        human: 0
        energy: 1
        materials: 2
        tech: 0
      cardKey: Iron Concord/Scrapper
  - name: Concrete bunker
    image: {fileID: 21300000, guid: de6a3cf512d99a442aa3dfad897b3902, type: 3}
    description: 'Your group has discovered a massive reinforced concrete bunker
      with a faded "Logistics & Supply" sign, hidden beneath the ruins of an old
      highway. Looks like someone is inside: 2 targets.'
    guardArmyName: Inhabitants
    rewards:
    - type: 0
      resources:
        human: 1
        energy: 0
        materials: 0
        tech: 1
      cardKey: 
  - name: Resort settlement
    image: {fileID: 21300000, guid: e899db11b325dca4abbf7d226647091f, type: 3}
    description: 'You found a mirage town - a pre-war resort settlement entirely
      constructed from heavy glass and polished steel, now half-buried by the desert
      dunes and perfectly preserving a surreal, frozen moment in time. Looks like
      someone is inside: 3 targets.'
    guardArmyName: Nomads
    rewards:
    - type: 0
      resources:
        human: 1
        energy: 1
        materials: 1
        tech: 0
      cardKey: 
  - name: Auto repair shop
    image: {fileID: 21300000, guid: f182ac5c45a6b894ba60e907bc147d9e, type: 3}
    description: 'Your combat group has stumbled upon a collapsed auto repair shop
      with a rusted, half-open roller shutter. Inside, the skeleton of an old pickup
      truck rests on a mechanical lift, frozen in time, providing temporary cover
      for your squad. Looks like someone is inside: 3 targets.'
    guardArmyName: Desert striders
    rewards:
    - type: 0
      resources:
        human: 1
        energy: 1
        materials: 1
        tech: 0
      cardKey: 
    - type: 1
      resources:
        human: 0
        energy: 0
        materials: 1
        tech: 0
      cardKey: Iron Concord/RC Vehicle
  - name: Nuclear silo
    image: {fileID: 21300000, guid: 26e3f7db440643843a22bba89cad625f, type: 3}
    description: 'You found a sunken nuclear silo whose massive concrete dome cracked
      and sunk halfway into a dry desert lakebed, leaving the gaping missile hatch
      exposed to the sky like a hollow stone well. Looks like someone is inside:
      3 targets.'
    guardArmyName: Brutes
    rewards:
    - type: 0
      resources:
        human: 0
        energy: 1
        materials: 1
        tech: 1
      cardKey: 
