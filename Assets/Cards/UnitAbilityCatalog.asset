  knownAbilities:
  - tag: AA
    title: 'AA'
    abbreviation: ''
    description: 'Intercepts enemy aircraft within the card''s anti-air radius.'
  - tag: Airfield
    title: 'Airfield'
    abbreviation: ''
    description: 'Mobile airfield: carries aircraft up to its Airfield Capacity.'
  - tag: ApBonus
    title: 'Ap Bonus'
    abbreviation: 'AP+2'
    description: '+2 AP each turn while in play.'
  - tag: Assembler
    title: 'Assembler'
    abbreviation: ''
    description: 'Hero can run Production at a Production Facility on its hex.'
  - tag: Barracks
    title: 'Barracks'
    abbreviation: 'Barracks'
    description: 'Accepts units deployed from hand and holds a garrison. Retreating armies head to the nearest own Barracks.'
  - tag: Berserk
    title: 'Berserk'
    abbreviation: ''
    description: 'Each hit taken in combat: +1 ATK, -1 DEF until the battle ends.'
  - tag: Bodyguard
    title: 'Bodyguard'
    abbreviation: ''
    description: 'Once per round takes a hit aimed at an adjacent ally instead. Heroes never guard.'
  - tag: CeramicArmor
    title: 'Ceramic Armor'
    abbreviation: ''
    description: '-1 to all damage received.'
  - tag: CollectEnergy
    title: 'Collect Energy'
    abbreviation: 'cE'
    description: 'Collects Energy from this hex each turn: 1 + upgrade level, up to the hex yield.'
  - tag: CollectHuman
    title: 'Collect Human'
    abbreviation: 'cH'
    description: 'Collects Human from this hex each turn: 1 + upgrade level, up to the hex yield.'
  - tag: CollectMaterials
    title: 'Collect Materials'
    abbreviation: 'cM'
    description: 'Collects Materials from this hex each turn: 1 + upgrade level, up to the hex yield.'
  - tag: CollectTech
    title: 'Collect Tech'
    abbreviation: 'cT'
    description: 'Collects Tech from this hex each turn: 1 + upgrade level, up to the hex yield.'
  - tag: Counterattack
    title: 'Counterattack'
    abbreviation: ''
    description: 'After surviving an attack from an adjacent cell (diagonals included), strikes the attacker back. Cancelled by Shock Attack.'
  - tag: CriticalDamage
    title: 'Critical Damage'
    abbreviation: 'Critical'
    description: 'Damage of a successful attack x2.'
  - tag: Disruption
    title: 'Disruption'
    abbreviation: 'DIS'
    description: 'On a hostile Base or Citadel hex, or arriving with an attacking army: cancels its building DEF bonus for the encounter. Does not reveal the carrier.'
  - tag: Drill
    title: 'Drill'
    abbreviation: ''
    description: 'Each combat round: +1 ATK for that round to the own ground unit with the highest ATK.'
  - tag: Explosion10
    title: 'Explosion 10'
    abbreviation: 'Exp 10'
    description: 'Replaces the attack with 10-die challenges against up to 10 random distinct units or structures on the target hex, allies included.'
  - tag: Explosion3
    title: 'Explosion 3'
    abbreviation: 'Exp 3'
    description: 'Replaces the attack with 10-die challenges against up to 3 random distinct units or structures on the target hex, allies included.'
  - tag: Explosion5
    title: 'Explosion 5'
    abbreviation: 'Exp 5'
    description: 'Replaces the attack with 10-die challenges against up to 5 random distinct units or structures on the target hex, allies included.'
  - tag: Heal
    title: 'Heal'
    abbreviation: ''
    description: 'Restores 1 HP to a random wounded Bio ally in its army: unit at the start of its combat turn, hero at the start of each round.'
  - tag: Hyperkinetic
    title: 'Hyperkinetic'
    abbreviation: 'Hyper+2'
    description: '+2 DMG vs Armored targets when the attack deals damage.'
  - tag: Ionic
    title: 'Ionic'
    abbreviation: ''
    description: '+2 DMG vs Mechanical targets when the attack deals damage.'
  - tag: ProduceEnergy
    title: 'Produce Energy'
    abbreviation: 'Energy+1'
    description: '+1 Energy income each turn while in play.'
  - tag: ProduceHuman
    title: 'Produce Human'
    abbreviation: 'Humans+1'
    description: '+1 Human income each turn while in play.'
  - tag: ProduceMaterials
    title: 'Produce Materials'
    abbreviation: 'Materials+1'
    description: '+1 Materials income each turn while in play.'
  - tag: ProduceTech
    title: 'Produce Tech'
    abbreviation: 'Tech+1'
    description: '+1 Tech income each turn while in play.'
  - tag: Production
    title: 'Production'
    abbreviation: ''
    description: 'Facility: enables Production for a hero with Assembler on this hex.'
  - tag: Pyrokinetic
    title: 'Pyrokinetic'
    abbreviation: 'Pyro+2'
    description: '+2 DMG vs Bio targets when the attack deals damage.'
  - tag: r1s0
    title: 'r1s0'
    abbreviation: 'r1s0'
    description: 'Army vision +1 hex. Cannot detect stealth units.'
  - tag: r1s4
    title: 'r1s4'
    abbreviation: 'r1s4'
    description: 'Army vision +1 hex. 4 dice to detect stealth units on its hex and adjacent hexes.'
  - tag: r1s5
    title: 'r1s5'
    abbreviation: 'r1s5'
    description: 'Army vision +1 hex. 5 dice to detect stealth units on its hex and adjacent hexes.'
  - tag: r1s6
    title: 'r1s6'
    abbreviation: 'r1s6'
    description: 'Army vision +1 hex. 6 dice to detect stealth units on its hex and adjacent hexes.'
  - tag: RaiseTheRots
    title: 'Raise The Rots'
    abbreviation: ''
    description: 'At battle start summons 2 extra units on its side while the grid has room. They fight for this battle only.'
  - tag: RapidReaction
    title: 'Rapid Reaction'
    abbreviation: 'Rapid'
    description: 'Deploys for 0 AP and moves in an army for 0 AP.'
  - tag: Regeneration
    title: 'Regeneration'
    abbreviation: 'Regen'
    description: 'Restores 1 HP (a Base: 1 structure point) at the end of the owner''s turn.'
  - tag: Repair
    title: 'Repair'
    abbreviation: ''
    description: 'Enables paid repair for all own armies on its hex.'
  - tag: Research
    title: 'Research'
    abbreviation: ''
    description: 'Facility: enables Research for a hero with Researcher on this hex.'
  - tag: Researcher
    title: 'Researcher'
    abbreviation: ''
    description: 'Hero can run Research at a Research Facility on its hex.'
  - tag: Scorcher
    title: 'Scorcher'
    abbreviation: ''
    description: 'On a damaging hit, one random adjacent unit takes half the damage if it is Bio.'
  - tag: ShockAttack
    title: 'Shock Attack'
    abbreviation: 'Shock'
    description: 'A damaging hit makes the target lose its pending turn this round and cancels its counterattack.'
  - tag: SingleUse
    title: 'Single Use'
    abbreviation: ''
    description: 'Equipment: consumed after an attack. Unit: expended after its attack.'
  - tag: Splash
    title: 'Splash'
    abbreviation: ''
    description: 'On a damaging hit, up to 2 random adjacent units, allies included, take half the damage.'
  - tag: Stealth4
    title: 'Stealth4'
    abbreviation: 'Stealth'
    description: 'Can enter stealth for 1 AP: hides with 4 dice, +1 or +2 on difficult terrain.'
  - tag: TacticalIntelligence
    title: 'Tactical Intelligence'
    abbreviation: 'Intel'
    description: 'Unlocks opponent intelligence while in play. Ground armies closer to an enemy citadel reveal more fields; fields change each turn.'
  - tag: Transport
    title: 'Transport'
    abbreviation: ''
    description: 'Raises the slowest Infantry in its army to the carrier''s Move.'
  criticalDamageMultiplier: 2
  ceramicArmorReduction: 1
  berserkAttackGain: 1
  berserkDefenseLoss: 1
  hyperkineticBonusDamage: 2
  pyrokineticBonusDamage: 2
  ionicBonusDamage: 2
  drillAttackBonus: 1
