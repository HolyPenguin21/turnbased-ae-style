        image: {fileID: 0}
      - id: ability-collecttech
        kind: 2
        text:
          key: help.topic.ability-collecttech.title
          fallback: "Collect Tech"
        image: {fileID: 0}
      - id: ability-collecttech-overview
        kind: 0
        text:
          key: help.topic.ability-collecttech.block.overview.text
          fallback: "Collects Tech from the carrier's hex under the collection rules. This uses available hex yield rather than creating an unlimited fixed resource bonus."
        image: {fileID: 0}
      - id: ability-collecttech-instructions
        kind: 0
        text:
          key: help.topic.ability-collecttech.block.instructions.text
          fallback: "Place a matching collector on a visited hex with available Tech yield and protect the location. Inspect the marginal income before constructing another collector or upgrading it."
        image: {fileID: 0}
      - id: ability-collecttech-rules
        kind: 0
        text:
          key: help.topic.ability-collecttech.block.rules.text
          fallback: "Collection is resolved at the new-round income step. A Facility contributes 1 plus its own upgrade level and the hex yield caps the harvest. Buildings collect first; eligible units with the matching Collect tag then take up to 1 each from the remainder, only when their owner has no combat-capable enemy on the hex. This is not the unconditional Produce bonus."
        image: {fileID: 0}
      - id: ability-regeneration
        kind: 2
        text:
          key: help.topic.ability-regeneration.title
          fallback: "Regeneration"
        image: {fileID: 0}
      - id: ability-regeneration-overview
        kind: 0
        text:
          key: help.topic.ability-regeneration.block.overview.text
          fallback: "Restores 1 HP (a Base: 1 structure point) at the end of the owner's turn."
        image: {fileID: 0}
      - id: ability-regeneration-instructions
        kind: 0
        text:
          key: help.topic.ability-regeneration.block.instructions.text
          fallback: "Keep a surviving wounded carrier in play until the end of its owner's turn."
        image: {fileID: 0}
      - id: ability-regeneration-rules
        kind: 0
        text:
          key: help.topic.ability-regeneration.block.rules.text
          fallback: "The current restoration is 1 HP for a living unit or 1 structure point for an eligible Base, never above maximum. Prisoners are excluded. This is an automatic end-turn effect, not a full repair action, and does not bring back a destroyed carrier."
        image: {fileID: 0}
      - id: ability-producehuman
        kind: 2
        text:
          key: help.topic.ability-producehuman.title
          fallback: "Produce Human"
        image: {fileID: 0}
      - id: ability-producehuman-overview
        kind: 0
        text:
          key: help.topic.ability-producehuman.block.overview.text
          fallback: "Grants 1 Human at the round's income step while the carrier is in play. This is a fixed resource bonus, separate from harvesting a deposit."
        image: {fileID: 0}
      - id: ability-producehuman-instructions
        kind: 0
        text:
          key: help.topic.ability-producehuman.block.instructions.text
          fallback: "Deploy or build the carrier and keep it in play to receive its Human contribution at the round's income step."
        image: {fileID: 0}
      - id: ability-producehuman-rules
        kind: 0
        text:
          key: help.topic.ability-producehuman.block.rules.text
          fallback: "Each eligible in-play source grants 1 Human, separate from the hex's collection limit. Multiple sources stack. A card in hand or a prisoner does not provide this ordinary source bonus. It is not awarded again each time the player opens or confirms a turn panel."
        image: {fileID: 0}
      - id: ability-produceenergy
        kind: 2
        text:
          key: help.topic.ability-produceenergy.title
          fallback: "Produce Energy"
        image: {fileID: 0}
